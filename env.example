# PUBLIC_URL (opcional, muy recomendado): la URL pública donde corre este mismo addon.
# Si la configuras, el propio servidor descarga el video con el Referer/User-Agent correcto
# y se lo entrega ya "limpio" a Stremio, en vez de depender de que el cliente de Stremio
# respete los proxyHeaders (algunos clientes, sobre todo móviles, los ignoran y el video falla).
# Ejemplo en Railway: PUBLIC_URL=https://tu-addon.up.railway.app
PUBLIC_URL=https://tu-addon.up.railway.app

# TMDB (opcional pero recomendado para metadatos vía IMDB/TMDB/Kitsu/MAL/AniList)
# Consíguelas gratis en https://www.themoviedb.org/settings/api
TMDB_API_KEY=tu_api_key_v3
TMDB_API_READ_TOKEN=tu_read_access_token_v4

# Railway inyecta PORT automáticamente, no hace falta declararla a mano
